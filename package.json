    "lint": "eslint .",
    "check:docs": "node tools/check/docs.mjs",
    "check:assets": "node tools/check/assets.mjs",
    "check:budget": "node tools/check/budget.mjs",
    "test": "node tools/check/run-tests.mjs",
    "sim": "node tools/sim/sim.mjs",
    "images": "node tools/build/webp.mjs public",
    "bake:souls": "node tools/sprites/bake_soul_portraits.mjs",
    "test:priorities": "node tools/tests/priorities.mjs",
    "test:spirit-limit": "node tools/tests/spirit-limit.mjs",
    "test:master-sword": "node tools/tests/master-sword.mjs",
    "test:gravemoon": "node tools/tests/gravemoon.mjs",
    "test:five-skins": "node tools/tests/five-skins.mjs",
    "test:shop-face-policy": "node tools/tests/shop-face-policy.mjs",
    "test:matrix-stage": "node tools/tests/matrix-stage.mjs",
    "test:cape-and-costumes": "node tools/tests/cape-and-costumes.mjs",
    "test:shop-cinematics": "node tools/tests/shop-cinematics.mjs",
    "test:premium-endings": "node tools/tests/premium-endings.mjs",
    "test:premium-animations": "node tools/tests/premium-animations.mjs",
    "test:skin-rarities": "node tools/tests/skin-rarities.mjs",
    "test:judgment": "python3 tools/tests/judgment-assets.py && node tools/tests/judgment.mjs",
    "test:young-link": "python3 tools/tests/young-link-assets.py && node tools/tests/young-link-flow.mjs && node tools/tests/young-link.mjs",
    "test:mobile": "python3 tools/tests/mobile-assets.py && node tools/tests/mobile.mjs",
    "build:mobile-assets": "python3 tools/sprites/mobile_atlases.py",
    "build:link-eyes": "python3 tools/sprites/young_link_eyes.py",
    "test:soul-board": "node tools/tests/soul-board-data.mjs && node tools/tests/soul-team-data.mjs && node tools/tests/soul-progression.mjs && node tools/tests/soul-board.mjs && node tools/tests/soul-battles.mjs && node tools/tests/soul-setup.mjs && node tools/tests/soul-party.mjs && node tools/tests/soul-reward.mjs && node tools/tests/new-souls.mjs && node tools/tests/soul-evolution-data.mjs && node tools/tests/soul-evolution.mjs && node tools/tests/steampunk-data.mjs && node tools/tests/steampunk.mjs",
    "test:soul-wave": "node tools/tests/soul-wave-data.mjs && node tools/tests/soul-wave.mjs",
    "test:neo-japan": "node tools/tests/neo-japan-data.mjs && node tools/tests/neo-japan.mjs",
    "test:fists": "python3 tools/tests/fists-assets.py && node tools/tests/fists.mjs",
    "test:bendy": "node tools/tests/neo-japan-data.mjs && node tools/tests/neo-japan.mjs",
    "test:grimoire": "node tools/tests/grimoire.mjs",
    "test:soul-potions": "node tools/tests/soul-potions-data.mjs && node tools/tests/soul-potions.mjs",
    "test:ninja-souls": "node tools/tests/ninja-souls-data.mjs && node tools/tests/ninja-souls.mjs"
